# Copie para .env e preencha com valores LOCAIS (nunca commite o .env)
#   copy .env.example .env

POSTGRES_DB=meusservicos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_HOST_PORT=5435

RABBITMQ_DEFAULT_USER=clientes
RABBITMQ_DEFAULT_PASS=CHANGE_ME_LOCAL_RABBIT_PASSWORD
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_GRAFANA_PASSWORD

# Spring (perfil docker / dev)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=clientes
SPRING_RABBITMQ_PASSWORD=CHANGE_ME_LOCAL_RABBIT_PASSWORD

# JWT — use strings longas e aleatórias (ex.: openssl rand -base64 48)
SECURITY_JWT_SIGNING_KEY=CHANGE_ME_BASE64_OR_LONG_RANDOM
SECURITY_JWT_CHAVE_ASSINATURA=CHANGE_ME_LONG_RANDOM_SIGNING_SECRET
SECURITY_JWT_EXPIRACAO=1200

APP_REGISTRATION_TOKEN_SECRET=CHANGE_ME_REGISTRATION_HASH_SECRET

# reCAPTCHA (opcional no lab local)
GOOGLE_RECAPTCHA_SITE=
GOOGLE_RECAPTCHA_SECRET=
